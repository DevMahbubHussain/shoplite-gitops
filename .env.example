# ArgoCD Server & Authentication
ARGOCD_SERVER=localhost:8080
ARGOCD_USERNAME=admin
ARGOCD_PASSWORD=ShopLiteArgoCD2026!
ARGOCD_INSECURE=true

# GitOps & Application Repositories
GITOPS_REPO_URL=https://github.com/DevMahbubHussain/shoplite-gitops.git
APP_REPO_URL=https://github.com/DevMahbubHussain/shoplite-app.git

# Kubernetes Cluster Configuration
KUBECONFIG=~/.kube/config
K8S_TARGET_SERVER=https://kubernetes.default.svc
DEV_NAMESPACE=shoplite-dev
PROD_NAMESPACE=shoplite
MONITORING_NAMESPACE=monitoring
